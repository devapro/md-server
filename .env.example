# Folder on the host with your Markdown files (absolute or relative to this file).
DOCS_DIR=./docs

# Port on the host the server is published on: http://localhost:8080
HOST_PORT=8080

# Name shown in the top bar and the browser tab.
SITE_TITLE=Docs

# Render raw HTML embedded in Markdown (e.g. <details>, <img width=...>).
# Only enable it if you trust everything in DOCS_DIR.
MD_ALLOW_HTML=false

# How long (ms) the sidebar tree is cached before the folder is re-scanned.
TREE_CACHE_MS=2000
